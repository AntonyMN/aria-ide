{
  "name": "aria-ide",
  "version": "0.1.0",
  "description": "Aria IDE - Open-Source Autonomous AI Development Environment powered by local, free, self-hosted LLMs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,VITE\" -c \"magenta,cyan\" \"node --watch server/index.js\" \"vite --host\"",
    "server": "node server/index.js",
    "client": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sweetalert2": "^11.26.25",
    "ws": "^8.22.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
